module Server
    intent =
        "An HTTP/1.1 serve loop that threads the game store through every request."
        "It follows the shape of the standard HttpServer, but the handler is a state transition rather than a pure response."
    depends [Bytes, HttpWire, Web.Router, Web.Store]
    exposes [listen]
    effects [Tcp.listen, Tcp.poll, Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close, Tcp.closeListener, Process.stopRequested, Random.int, Time.unixMs, Disk.readText]

record Session
    connection: Tcp.Connection
    buffer: Bytes

record Node
    listener: Tcp.Listener
    sessions: Map<Int, Session>
    nextKey: Int
    store: Store
    reloading: Bool

record DispatchFailure
    node: Node
    reason: String

fn listen(port: Int, store: Store, reloading: Bool) -> Result<Unit, String>
    ? "Binds the port and serves until SIGINT or SIGTERM asks for a cooperative shutdown."
    ! [Tcp.listen, Tcp.poll, Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close, Tcp.closeListener, Process.stopRequested, Random.int, Time.unixMs, Disk.readText]
    run(Node(listener = Tcp.listen(port, 128)?, sessions = {}, nextKey = 1, store = store, reloading = reloading))

fn run(node: Node) -> Result<Unit, String>
    ? "One tick: check for shutdown, draw the randomness and the clock reading this tick will use, then wait for readable sockets."
    ! [Tcp.poll, Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close, Tcp.closeListener, Process.stopRequested, Random.int, Time.unixMs, Disk.readText]
    keys = Map.keys(node.sessions)
    match Process.stopRequested()
        true -> shutdown(node)
        false -> pollNext(reloaded(node), Web.Router.Tick(entropy = Random.int(0, 4611686018427387903), now = Time.unixMs()), Tcp.poll(sockets(node.sessions, keys, {0 => Tcp.Socket.Listening(node.listener)}), 250))

fn reloaded(node: Node) -> Node
    ? "In development the pages, the stylesheet and the scripts are re-read each tick, so an edit shows on the next reload without losing the games in progress."
    ! [Disk.readText]
    match node.reloading
        false -> node
        true -> Node.update(node, store = reread(node.store))

fn reread(store: Store) -> Store
    ? "Re-reads every file the store was built from."
    ! [Disk.readText]
    Web.Store.withAsset(Web.Store.withAsset(Web.Store.withAsset(pages(store), "avgo.css", fresh("web/static/avgo.css", Web.Store.assetBody(store, "avgo.css")), "text/css; charset=utf-8"), "lobby.js", fresh("web/static/lobby.js", Web.Store.assetBody(store, "lobby.js")), "text/javascript; charset=utf-8"), "game.js", fresh("web/static/game.js", Web.Store.assetBody(store, "game.js")), "text/javascript; charset=utf-8")

fn pages(store: Store) -> Store
    ? "The two pages are re-read the same way the assets are."
    ! [Disk.readText]
    Web.Store.withPages(store, fresh("web/static/lobby.html", store.lobbyPage), fresh("web/static/game.html", store.gamePage))

fn fresh(path: String, current: String) -> String
    ? "A file caught half-written reads as an error, and the last good copy is kept rather than serving a truncated page."
    ! [Disk.readText]
    keep(Disk.readText(path), current)

fn keep(read: Result<String, String>, current: String) -> String
    ? "An unreadable file leaves what is already loaded in place."
    match read
        Result.Err(_) -> current
        Result.Ok(text) -> text

fn pollNext(node: Node, tick: Web.Router.Tick, ready: Result<List<Int>, String>) -> Result<Unit, String>
    ? "A poll failure closes every resource before the original error escapes."
    ! [Tcp.poll, Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close, Tcp.closeListener, Process.stopRequested, Random.int, Time.unixMs, Disk.readText]
    match ready
        Result.Err(reason) -> fail(node, reason)
        Result.Ok(keys) -> continue(node, dispatch(node, tick, keys))

fn continue(node: Node, next: Result<Node, DispatchFailure>) -> Result<Unit, String>
    ? "A per-session failure never kills the server; a listener failure still tears everything down."
    ! [Tcp.poll, Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close, Tcp.closeListener, Process.stopRequested, Random.int, Time.unixMs, Disk.readText]
    match next
        Result.Err(failure) -> fail(failure.node, failure.reason)
        Result.Ok(updated) -> run(updated)

fn dispatch(node: Node, tick: Web.Router.Tick, ready: List<Int>) -> Result<Node, DispatchFailure>
    ? "Serves every key the poll reported ready, carrying the store forward between them."
    ! [Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close]
    match ready
        [] -> Result.Ok(node)
        [key, ..rest] -> match serveKey(node, tick, key)
            Result.Err(reason) -> Result.Err(DispatchFailure(node = node, reason = reason))
            Result.Ok(updated) -> dispatch(updated, tick, rest)

fn serveKey(node: Node, tick: Web.Router.Tick, key: Int) -> Result<Node, String>
    ? "Key zero is the listener; every positive key is one open HTTP session."
    ! [Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close]
    match key == 0
        true -> acceptOne(node)
        false -> match Map.get(node.sessions, key)
            Option.None -> Result.Ok(node)
            Option.Some(session) -> pump(node, tick, key, session)

fn acceptOne(node: Node) -> Result<Node, String>
    ? "Accept stays non-blocking, so a false wakeup costs nothing."
    ! [Tcp.accept]
    match Tcp.accept(node.listener)
        Result.Err(reason) -> Result.Err(reason)
        Result.Ok(accepted) -> match accepted
            Option.None -> Result.Ok(node)
            Option.Some(connection) -> Result.Ok(Node.update(node, sessions = Map.set(node.sessions, node.nextKey, Session(connection = connection, buffer = String.toUtf8(""))), nextKey = node.nextKey + 1))

fn pump(node: Node, tick: Web.Router.Tick, key: Int, session: Session) -> Result<Node, String>
    ? "Reads one available chunk; a broken connection removes only its own session."
    ! [Tcp.readSome, Tcp.writeBytes, Tcp.close]
    match Tcp.readSome(session.connection, 65536)
        Result.Err(_) -> dropSession(node, key, session)
        Result.Ok(chunk) -> absorb(node, tick, key, session, chunk)

fn absorb(node: Node, tick: Web.Router.Tick, key: Int, session: Session, chunk: Bytes) -> Result<Node, String>
    ? "Empty bytes are a clean EOF; anything else extends the framing buffer."
    ! [Tcp.writeBytes, Tcp.close]
    match Bytes.octets(chunk)
        [] -> dropSession(node, key, session)
        [_, .._] -> match Bytes.fromList(List.concat(Bytes.octets(session.buffer), Bytes.octets(chunk)))
            Result.Err(_) -> dropSession(node, key, session)
            Result.Ok(buffer) -> frame(node, tick, key, Session(connection = session.connection, buffer = buffer))

fn frame(node: Node, tick: Web.Router.Tick, key: Int, session: Session) -> Result<Node, String>
    ? "Complete requests are answered immediately; a partial one waits for the next poll."
    ! [Tcp.writeBytes, Tcp.close]
    match HttpWire.frameRequest(session.buffer)
        HttpWire.Framed.Partial -> Result.Ok(remember(node, key, session))
        HttpWire.Framed.Malformed(reason) -> refuse(node, key, session, reason)
        HttpWire.Framed.Complete(request, used) -> answer(node, tick, key, session, request, used, Web.Router.handle(node.store, tick, request))

fn answer(node: Node, tick: Web.Router.Tick, key: Int, session: Session, request: HttpRequest, used: Int, reply: Web.Router.Reply) -> Result<Node, String>
    ? "The router's new store is adopted whether or not the write to this one client succeeds."
    ! [Tcp.writeBytes, Tcp.close]
    match HttpWire.renderResponse(reply.response)
        Result.Err(_) -> dropSession(Node.update(node, store = reply.store), key, session)
        Result.Ok(payload) -> match Tcp.writeBytes(session.connection, payload)
            Result.Err(_) -> dropSession(Node.update(node, store = reply.store), key, session)
            Result.Ok(_) -> afterAnswer(Node.update(node, store = reply.store), tick, key, session, request, used, reply.response)

fn afterAnswer(node: Node, tick: Web.Router.Tick, key: Int, session: Session, request: HttpRequest, used: Int, response: Http.Response) -> Result<Node, String>
    ? "Honours connection close, and otherwise advances the buffer by exactly the framed byte count."
    ! [Tcp.writeBytes, Tcp.close]
    match Bool.or(HttpWire.requestCloses(request), HttpWire.responseCloses(response))
        true -> dropSession(node, key, session)
        false -> match Bytes.fromList(List.drop(Bytes.octets(session.buffer), used))
            Result.Err(_) -> dropSession(node, key, session)
            Result.Ok(buffer) -> frame(node, tick, key, Session(connection = session.connection, buffer = buffer))

fn refuse(node: Node, key: Int, session: Session, reason: String) -> Result<Node, String>
    ? "Unframeable input gets one bounded 400 and then the stream closes."
    ! [Tcp.writeBytes, Tcp.close]
    match HttpWire.renderResponse(Http.Response(status = 400, body = reason + "\n", headers = {"connection" => ["close"], "content-type" => ["text/plain; charset=utf-8"]}))
        Result.Err(_) -> dropSession(node, key, session)
        Result.Ok(payload) -> match Tcp.writeBytes(session.connection, payload)
            Result.Err(_) -> dropSession(node, key, session)
            Result.Ok(_) -> dropSession(node, key, session)

fn remember(node: Node, key: Int, session: Session) -> Node
    ? "Stores incomplete framing state under the session's poll key."
    Node.update(node, sessions = Map.set(node.sessions, key, session))

fn dropSession(node: Node, key: Int, session: Session) -> Result<Node, String>
    ? "Closing an already-broken session may fail; the session is forgotten either way."
    ! [Tcp.close]
    match Tcp.close(session.connection)
        Result.Err(_) -> Result.Ok(without(node, key))
        Result.Ok(_) -> Result.Ok(without(node, key))

fn without(node: Node, key: Int) -> Node
    ? "Forgets one session without disturbing the listener or key allocation."
    Node.update(node, sessions = Map.remove(node.sessions, key))

fn fail(node: Node, reason: String) -> Result<Unit, String>
    ? "Cleanup is attempted before the triggering error is returned."
    ! [Tcp.close, Tcp.closeListener]
    match shutdown(node)
        Result.Err(cleanup) -> Result.Err("{reason}; cleanup failed: {cleanup}")
        Result.Ok(_) -> Result.Err(reason)

fn shutdown(node: Node) -> Result<Unit, String>
    ? "Closes every accepted connection and releases the listener last."
    ! [Tcp.close, Tcp.closeListener]
    closeSessions(Map.values(node.sessions), node.listener)

fn closeSessions(sessions: List<Session>, listener: Tcp.Listener) -> Result<Unit, String>
    ? "Session cleanup is best effort; listener cleanup stays observable."
    ! [Tcp.close, Tcp.closeListener]
    match sessions
        [] -> Tcp.closeListener(listener)
        [session, ..rest] -> match Tcp.close(session.connection)
            Result.Err(_) -> closeSessions(rest, listener)
            Result.Ok(_) -> closeSessions(rest, listener)

fn sockets(sessions: Map<Int, Session>, keys: List<Int>, acc: Map<Int, Tcp.Socket>) -> Map<Int, Tcp.Socket>
    ? "Projects the open sessions into the one typed wait map Tcp.poll consumes."
    match keys
        [] -> acc
        [key, ..rest] -> match Map.get(sessions, key)
            Option.None -> sockets(sessions, rest, acc)
            Option.Some(session) -> sockets(sessions, rest, Map.set(acc, key, Tcp.Socket.Connected(session.connection)))

verify sockets
    sockets({}, [], {}) => {}
    sockets({}, [1, 2], {}) => {}

verify keep
    keep(Result.Ok("new"), "old") => "new"
    keep(Result.Err("gone"), "old") => "old"
